{
  "name": "finance-tracker",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "generate:mobile": "cross-env NUXT_APP_BASE_URL=./ NUXT_NATIVE_BUILD=true nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "seed": "node .course/seed.mjs",
    "cap:sync": "pnpm run generate:mobile && cap sync",
    "cap:sync:android": "pnpm run generate:mobile && cap sync android",
    "cap:android": "cap open android",
    "build:android:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/push-notifications": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2",
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/supabase": "^2.0.4",
    "@supabase/supabase-js": "^2.97.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "heroicons": "link:@iconify-json\\heroicons",
    "nuxt": "^4.3.1",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@faker-js/faker": "^10.3.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "cross-env": "^7.0.3"
  }
}
